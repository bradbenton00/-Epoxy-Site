modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-mail:1.0.0", "google-sheet:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 24903
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
LEADS_SHEET_WEBHOOK_URL = "https://script.google.com/macros/s/AKfycbyHImoZi_x-FurbQ_T1IXE1Xk-9-zcJWgUL7Et9dAu9RuCUPPjok0_Us-E_fplLtr7o5w/exec"
